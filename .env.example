# Copy to .env and adjust. Never commit the real .env file.

# --- Core -----------------------------------------------------------------
ENVIRONMENT=development            # development | test | production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
TIMEZONE=Africa/Nairobi

# --- Database ---------------------------------------------------------------
# Local development (no setup needed):
DATABASE_URL=sqlite:///./invoiceflow.db
# Production / docker-compose (PostgreSQL):
# DATABASE_URL=postgresql://invoiceflow:invoiceflow@db:5432/invoiceflow

# Used by docker-compose for the bundled PostgreSQL container.
POSTGRES_USER=invoiceflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=invoiceflow

# --- Web --------------------------------------------------------------------
# Browser origins allowed to call the API (comma separated). Not needed when the
# API serves the built frontend from the same origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public URL of the app, used to build shareable invoice links.
PUBLIC_APP_URL=http://localhost:5173

# --- Rate limiting (per IP, per process) -----------------------------------
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60

# --- Optional: email delivery via SMTP ------------------------------------
# Leave SMTP_HOST empty to disable. The app then prepares emails for the user
# to send from their own mail app instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=InvoiceFlow
