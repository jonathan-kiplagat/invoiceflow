      "lines": [
        { "subtotal": "123456780.00", "discount": "3086419.50", "tax": "19259257.68", "total": "139629618.18" },
        { "subtotal": "0.30", "discount": "0.00", "tax": "0.00", "total": "0.30" }
      ],
      "totals": { "subtotal": "123456780.30", "discount_total": "3086419.50", "tax_total": "19259257.68", "shipping": "0.10", "total": "139629618.58" }
    }
  ]
